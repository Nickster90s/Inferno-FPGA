build/
firmware/*.o
firmware/*.d
firmware/firmware.elf
firmware/firmware.elf.map
firmware/firmware.bin
__pycache__/
*.pyc
*.vcd
csr.csv
analyzer.csv
stream.cfg

# Build-artifact snapshots (archive.sh) — large binaries, kept locally only.
# UITZONDERING: de gevalideerde artifacts worden met `git add -f` WEL vastgelegd.
# Op 2026-11-04 bleek de enige werkende dual-USB bitstream alleen in een
# sessie-temp-map te bestaan, een opruimactie van verloren -- en `flash.sh` wees
# ondertussen naar de single-USB build. Een .bit is 2,1 MB; dat is de prijs niet
# waard om te verliezen. De .info's zijn klein en horen altijd mee.
bitstreams/*.bit
bitstreams/*.info
!bitstreams/*_BOTH-CLEAN.bit
!bitstreams/*_BOTH-CLEAN.info
!bitstreams/*_VERIFIED.bit
!bitstreams/*_VERIFIED.info
# editor/backup scratch
*.bak
*~

# --- Dante fork: keep artifacts out of the Inferno-FPGA repo -----------------
# These were TRACKED in avb-aes3 (added before the ignore rules existed), so
# .gitignore alone did not exclude them. 159MB -> 3.9MB by dropping them from
# the initial commit. All still present on disk and in the avb-aes3 history.
sim/*.vcd
sim/*.vvp
blinky/blinky.bit
blinky/blinky.fasm
blinky/blinky.frames
blinky/blinky.json

# Phase 0.5 tooling artifacts
firmware/loader/*.o
firmware/loader/*.d
firmware/loader/loader.elf
firmware/loader/loader.elf.map
firmware/loader/loader.bin
firmware/*.img
build_seed*/
# Elke build-output: 229 MB per directory (routed json + fasm + frames). De
# build_seed*-regel hierboven dekte de dual-USB bring-up niet, die zijn dirs
# anders noemde -- vandaar het patroon op prefix in plaats van op een naam.
build_dante_*/
build_dual_*/
build_sweep/
build_sweep.log
build_usb2_*/
# En nu op prefix, want de lijst hierboven liep opnieuw achter: build_csrchk2/
# en build_ring48_s1/ stonden untracked en zijn 229 MB per stuk. Elke
# build-output van dit project begint met build_, dus dek dat af in plaats van
# er bij elke nieuwe naam een regel bij te zetten.
build_*/
# Verilog-backups van tools/gen_usb_subsystem.py: de originelen zitten in de
# geschiedenis, dus een kopie op schijf hoort niet in de repo.
*.pre-dante-bak
tools/seed_sweep_logs/
tools/seed_sweep_results.txt
firmware/loader/.build.lock
# Zoekruns van 2026-11-04 (floorplan/seed): zelfde 229 MB per dir als build_seed*.
build_hunt_*/
# 2026-11-04 usb-marge-experimenten; zelfde 229 MB per dir.
build_usbmargin_*/
build_usbdefault_*/
build_phase333_*/
